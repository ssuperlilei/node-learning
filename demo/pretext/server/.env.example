PORT=3780

# OpenRouter：https://openrouter.ai/keys（不要把真实密钥提交到仓库，复制本文件为 .env 再填写）
OPENROUTER_API_KEY=

# OpenAI 兼容端点，须能拼出 …/v1/chat/completions（不要末尾斜杠）
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 模型 ID 以 OpenRouter 为准，例如 openai/gpt-4o-mini、openrouter/free
OPENROUTER_MODEL=openai/gpt-4o-mini

# 可选：OpenRouter 统计/排名用（见 https://openrouter.ai/docs）
# OPENROUTER_HTTP_REFERER=http://localhost:5178
# OPENROUTER_APP_TITLE=Pretext AI Chat Demo

# 可选：不配 OPENROUTER_API_KEY 时可直接连 OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
