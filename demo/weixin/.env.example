# ============================================================
# 微信 AI Bot 配置
# 复制本文件为 .env 并填写配置
# ============================================================

# iLink 服务器（一般不需要改）
ILINK_BASE_URL=https://ilinkai.weixin.qq.com

# ── 登录 Token（首次扫码后自动写入，无需手动填写）──────────────
BOT_TOKEN=
BOT_BASEURL=

# ── 监听的好友 ──────────────────────────────────────────────
# 格式：xxx@im.wechat
# 留空则打印所有收到的消息（发现模式，帮你找到好友 ID）
WATCH_FRIEND_ID=

# ── AI 配置（与 pretext 共用 OpenRouter）──────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=openrouter/free

# 或者直接用 OpenAI
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── AI 系统提示词 ────────────────────────────────────────────
AI_SYSTEM_PROMPT=你是一个友好的 AI 助手，请用简洁自然的中文回复，控制在 200 字以内。
